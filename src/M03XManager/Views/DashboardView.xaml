<UserControl x:Class="M03XManager.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:M03XManager.Controls">

    <UserControl.Resources>

        <!-- ============ 磁贴内容模板 ============ -->

        <DataTemplate x:Key="TileOverview">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="累计下载" Style="{StaticResource FieldLabel}" />
                        <TextBlock Text="{Binding Owner.CumulativeRxText}" Style="{StaticResource BigValue}" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="累计上传" Style="{StaticResource FieldLabel}" />
                        <TextBlock Text="{Binding Owner.CumulativeTxText}" Style="{StaticResource BigValue}" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="累计合计" Style="{StaticResource FieldLabel}" />
                        <TextBlock Text="{Binding Owner.CumulativeTotalText}" Style="{StaticResource BigValue}" Margin="0,4,0,0"
                                   Foreground="{DynamicResource B.Accent}" />
                    </StackPanel>
                </Grid>

                <Border Background="{DynamicResource B.SurfaceAlt}" CornerRadius="{DynamicResource R.Small}"
                        Padding="12,10" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="今日流量（本地采样）" Style="{StaticResource ListHeader}" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Owner.TodayRxText}" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text=" ↓ 下载 · " Style="{StaticResource Note}" VerticalAlignment="Bottom" />
                            <TextBlock Text="{Binding Owner.TodayTxText}" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text=" ↑ 上传 · " Style="{StaticResource Note}" VerticalAlignment="Bottom" />
                            <TextBlock Text="{Binding Owner.TodayTotalText}" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource B.Accent}" />
                            <TextBlock Text=" 合计" Style="{StaticResource Note}" VerticalAlignment="Bottom" />
                        </StackPanel>
                        <TextBlock Text="{Binding Owner.TodayDeviceLevelText}" Style="{StaticResource Note}" Margin="0,6,0,0" />
                        <TextBlock Text="{Binding Owner.DataUpdatedText}" Style="{StaticResource Note}" />
                    </StackPanel>
                </Border>

                <TextBlock Text="{Binding Owner.CoverageText}" Style="{StaticResource Note}" Margin="0,10,0,0" />
                <TextBlock Text="{Binding Owner.UncapturedText}" Style="{StaticResource Note}" Margin="0,2,0,0" />
                <TextBlock Text="{Binding Owner.DataSourceNote}" Style="{StaticResource Note}" Margin="0,8,0,0" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="TileStats">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource SegmentHost}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="当日" Style="{StaticResource SegmentItem}" GroupName="StatsPeriod"
                                     IsChecked="{Binding Owner.IsDayPeriod}" />
                        <RadioButton Content="近七天" Style="{StaticResource SegmentItem}" GroupName="StatsPeriod"
                                     IsChecked="{Binding Owner.IsWeekPeriod}" />
                        <RadioButton Content="本月" Style="{StaticResource SegmentItem}" GroupName="StatsPeriod"
                                     IsChecked="{Binding Owner.IsMonthPeriod}" />
                    </StackPanel>
                </Border>

                <controls:BarChart Grid.Row="1" Margin="0,12,0,0" MinHeight="120"
                                   Items="{Binding Owner.Bars}" x:Name="TrafficBar"
                                   BarSelected="OnBarSelected" />

                <StackPanel Grid.Row="2" Margin="0,10,0,0">
                    <TextBlock Text="{Binding Owner.PeriodSummary}" Style="{StaticResource FieldValue}" />
                    <TextBlock Text="{Binding Owner.PeriodScope}" Style="{StaticResource Note}" Margin="0,4,0,0" />
                </StackPanel>

                <StackPanel Grid.Row="3" Margin="0,10,0,0">
                    <TextBlock Text="{Binding Owner.DetailTitle}" Style="{StaticResource ListHeader}" />
                    <ItemsControl ItemsSource="{Binding Owner.DetailRows}" MaxHeight="160">
                        <ItemsControl.Template>
                            <ControlTemplate TargetType="ItemsControl">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </ControlTemplate>
                        </ItemsControl.Template>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Text="{Binding Rx}" FontSize="12" Margin="10,0,0,0"
                                               Foreground="{DynamicResource B.Down}" />
                                    <TextBlock Grid.Column="2" Text="{Binding Tx}" FontSize="12" Margin="10,0,0,0"
                                               Foreground="{DynamicResource B.Up}" />
                                    <TextBlock Grid.Column="3" Text="{Binding Total}" FontSize="12" Margin="10,0,0,0"
                                               FontWeight="SemiBold" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="TileSpeedChart">
            <StackPanel>
                <controls:TrendChart Points="{Binding Owner.Samples}" Mode="Speed" MinHeight="110" />
                <TextBlock Style="{StaticResource Note}" Margin="0,8,0,0"
                           Text="本机采样：由设备累计字节数按时间差分得到；设备上报的瞬时值另见「移动网络」页。" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="TileSignalChart">
            <controls:TrendChart Points="{Binding Owner.Samples}" Mode="Signal" MinHeight="110" />
        </DataTemplate>

        <DataTemplate x:Key="TileStatus">
            <StackPanel>
                <TextBlock Text="{Binding Owner.ConnectionState}" Style="{StaticResource BigValue}" />
                <TextBlock Style="{StaticResource Note}" Margin="0,8,0,0">
                    <Run Text="运营商：" /><Run Text="{Binding Owner.Operator, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Style="{StaticResource Note}" Margin="0,3,0,0">
                    <Run Text="网络制式：" /><Run Text="{Binding Owner.NetworkMode, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Style="{StaticResource Note}" Margin="0,3,0,0">
                    <Run Text="在线终端：" /><Run Text="{Binding Owner.ClientsText, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Style="{StaticResource Note}" Margin="0,3,0,0">
                    <Run Text="运行时长：" /><Run Text="{Binding Owner.RunTimeText, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Style="{StaticResource Note}" Margin="0,3,0,0">
                    <Run Text="电池：" /><Run Text="{Binding Owner.BatteryText, Mode=OneWay}" />
                </TextBlock>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="TileSignal">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Owner.SignalLevelText}" Style="{StaticResource BigValue}" />
                    <TextBlock Style="{StaticResource Note}" VerticalAlignment="Bottom" Margin="8,0,0,4">
                        <Run Text="档位 " /><Run Text="{Binding Owner.SignalBarsText, Mode=OneWay}" /><Run Text=" / 5" />
                    </TextBlock>
                </StackPanel>
                <TextBlock Text="{Binding Owner.SignalDetail}" Style="{StaticResource Note}" Margin="0,8,0,0" />
                <TextBlock Text="{Binding Owner.SampleDownText}" Style="{StaticResource MonoValue}" Margin="0,10,0,0" />
                <TextBlock Text="{Binding Owner.SampleUpText}" Style="{StaticResource MonoValue}" />
                <TextBlock Text="{Binding Owner.DeviceSpeedText}" Style="{StaticResource Note}" Margin="0,6,0,0" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="TileDeviceInfo">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Style="{StaticResource Note}"><Run Text="设备名称  " /><Run Text="{Binding Owner.DeviceName, Mode=OneWay}" /></TextBlock>
                    <TextBlock Style="{StaticResource Note}" Margin="0,3,0,0"><Run Text="固件版本  " /><Run Text="{Binding Owner.FirmwareVersion, Mode=OneWay}" /></TextBlock>
                    <TextBlock Style="{StaticResource Note}" Margin="0,3,0,0"><Run Text="硬件版本  " /><Run Text="{Binding Owner.HardwareVersion, Mode=OneWay}" /></TextBlock>
                    <TextBlock Style="{StaticResource Note}" Margin="0,3,0,0"><Run Text="序列号  " /><Run Text="{Binding Owner.SerialNumber, Mode=OneWay}" /></TextBlock>
                    <TextBlock Style="{StaticResource Note}" Margin="0,3,0,0"><Run Text="IMEI  " /><Run Text="{Binding Owner.Imei, Mode=OneWay}" /></TextBlock>
                    <TextBlock Style="{StaticResource Note}" Margin="0,3,0,0"><Run Text="ICCID  " /><Run Text="{Binding Owner.Iccid, Mode=OneWay}" /></TextBlock>
                    <TextBlock Style="{StaticResource Note}" Margin="0,3,0,0"><Run Text="WAN / LAN  " /><Run Text="{Binding Owner.WanIp, Mode=OneWay}" /><Run Text=" / " /><Run Text="{Binding Owner.LanIp, Mode=OneWay}" /></TextBlock>
                    <TextBlock Style="{StaticResource Note}" Margin="0,3,0,0"><Run Text="SSID  " /><Run Text="{Binding Owner.Ssid, Mode=OneWay}" /></TextBlock>
                    <TextBlock Style="{StaticResource Note}" Margin="0,3,0,0"><Run Text="MAC  " /><Run Text="{Binding Owner.MacAddress, Mode=OneWay}" /></TextBlock>
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>

        <DataTemplate x:Key="TileNetwork">
            <StackPanel>
                <TextBlock Text="{Binding Owner.PdpSummary}" Style="{StaticResource FieldValue}" />
                <TextBlock Text="{Binding Owner.LteCellSummary}" Style="{StaticResource Note}" Margin="0,10,0,0" />
                <TextBlock Text="{Binding Owner.TrafficText}" Style="{StaticResource Note}" Margin="0,10,0,0" />
                <TextBlock Text="{Binding Owner.MonthDeviceLevelText}" Style="{StaticResource Note}" Margin="0,6,0,0" />
                <TextBlock Text="{Binding Owner.Month3DayDeviceText}" Style="{StaticResource Note}" Margin="0,3,0,0" />
            </StackPanel>
        </DataTemplate>

        <!-- ============ 磁贴外壳（标题栏 + 编辑操作 + 拖动） ============ -->
        <DataTemplate x:Key="TileHost">
            <Border ClipToBounds="True">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource Tile}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsDragging}" Value="True">
                                <Setter Property="Opacity" Value="0.65" />
                                <Setter Property="BorderBrush" Value="{DynamicResource B.Accent}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Border.RenderTransform>
                    <TranslateTransform />
                </Border.RenderTransform>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" Cursor="Hand"
                                      ToolTip="长按 0.5 秒进入编辑，可直接拖动排序">
                            <TextBlock Text="&#xE76F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="12" Foreground="{DynamicResource B.TextFaint}" VerticalAlignment="Center"
                                       Margin="0,0,8,0" />
                            <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"
                                       Visibility="{Binding ShowTitle, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                    Visibility="{Binding Owner.IsEditing, Converter={StaticResource BoolToVisibility}}">
                            <Button Content="－" Style="{StaticResource GhostButton}" Padding="8,2" Margin="0,0,4,0"
                                    ToolTip="缩小磁贴"
                                    Command="{Binding Owner.ShrinkTileCommand}" CommandParameter="{Binding}" />
                            <Button Content="＋" Style="{StaticResource GhostButton}" Padding="8,2" Margin="0,0,4,0"
                                    ToolTip="放大磁贴"
                                    Command="{Binding Owner.GrowTileCommand}" CommandParameter="{Binding}" />
                            <Button Content="标题" Style="{StaticResource GhostButton}" Padding="8,2"
                                    ToolTip="显示/隐藏该磁贴标题"
                                    Command="{Binding Owner.ToggleTileTitleCommand}" CommandParameter="{Binding}" />
                        </StackPanel>
                    </Grid>

                    <ContentControl Grid.Row="1" Content="{Binding}" ClipToBounds="True">
                        <ContentControl.Style>
                            <Style TargetType="ContentControl">
                                <Setter Property="ContentTemplate" Value="{StaticResource TileStatus}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Kind}" Value="Overview">
                                        <Setter Property="ContentTemplate" Value="{StaticResource TileOverview}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="Stats">
                                        <Setter Property="ContentTemplate" Value="{StaticResource TileStats}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="SpeedChart">
                                        <Setter Property="ContentTemplate" Value="{StaticResource TileSpeedChart}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="SignalChart">
                                        <Setter Property="ContentTemplate" Value="{StaticResource TileSignalChart}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="Signal">
                                        <Setter Property="ContentTemplate" Value="{StaticResource TileSignal}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="DeviceInfo">
                                        <Setter Property="ContentTemplate" Value="{StaticResource TileDeviceInfo}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="Network">
                                        <Setter Property="ContentTemplate" Value="{StaticResource TileNetwork}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                    </ContentControl>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" CornerRadius="{DynamicResource R.Small}" Padding="12,8" Margin="0,0,0,12"
                Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisibility}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource B.AccentSoft}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsError}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource B.DangerSoft}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="12" />
        </Border>

        <!-- 磁贴操作入口（原先这里还有一条与通知重复的提示横幅，已移除，提示统一走通知中心） -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,12">
            <TextBlock Text="{Binding SaveStatusText}" Style="{StaticResource Note}" VerticalAlignment="Center"
                       Margin="0,0,12,0"
                       Visibility="{Binding SaveStatusText, Converter={StaticResource StrToVisibility}}" />
            <!-- 与「恢复默认布局」使用同一套 Command 机制（Click 事件在这块区域不生效） -->
            <Button x:Name="DoneEditButton" Content="完成" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"
                    Command="{Binding FinishEditingCommand}"
                    Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}" />
            <Button Content="编辑磁贴" Style="{StaticResource GhostButton}" Margin="0,0,8,0"
                    Command="{Binding ToggleEditModeCommand}"
                    ToolTip="{Binding LayoutHint}"
                    Visibility="{Binding IsNotEditing, Converter={StaticResource BoolToVisibility}}" />
            <Button Content="恢复默认布局" Style="{StaticResource GhostButton}"
                    Command="{Binding ResetLayoutCommand}" />
        </StackPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="TilesHost" ItemsSource="{Binding Tiles}" ItemTemplate="{StaticResource TileHost}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <controls:TileGrid />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
